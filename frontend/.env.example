# YeboBank demo environment. Copy to .env.local and fill in local-only values.
# Never commit real secrets. Test contact details: 0707172370 / 5tan@altradits.com.

# Backend switch: leave unset (or "mock") for mock-data demo (Vercel default).
# Set to "on" to use the built-in demo backend (local/CI only, test sats only).
YEBO_BACKEND=

# Demo backend (only read when YEBO_BACKEND=on)
DATABASE_PATH=.data/yebo.json
SESSION_SECRET=change-me-to-32-random-bytes-locally
PIN_PEPPER=change-me-locally
CSRF_SECRET=change-me-locally

# Altradits Developer API sandbox (Lightning operations). Sandbox keys only.
ALTRADITS_API_BASE=http://127.0.0.1:8787/api/dev/v1
ALTRADITS_API_KEY=
ALTRADITS_WEBHOOK_SECRET=
# Set to "fake" to use the in-repo fake instead of a sandbox server.
ALTRADITS_MODE=fake
# YeboBank destination Lightning address for deposits (test network).
YEBO_DESTINATION_ADDRESS=yebo-demo@signet.example

# Local regtest LND for the fake/sandbox internals only (never mainnet).
# Never point these at a mainnet node (~/.lnd-altradits).
# LND_REGTEST_REST_URL=
# LND_REGTEST_INVOICE_MACAROON=
# LND_REGTEST_READONLY_MACAROON=
# LND_REGTEST_TLS_CERT=
