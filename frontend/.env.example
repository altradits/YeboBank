# YeboBank environment. Copy to .env.local and fill in local-only values.
# Never commit real secrets. Test contact details: 0707172370 / 5tan@altradits.com.

# --- Backend switches ---
# Mock-data demo by default (Vercel). Set to "on" to use the built-in demo
# backend (/api/*, test sats only, local/CI).
YEBO_BACKEND=
NEXT_PUBLIC_YEBO_BACKEND=
# Bitcoin rail goes live independently of the rest of the backend: set
# NEXT_PUBLIC_BITCOIN_LIVE=true and the Lightning functions call the real
# /api routes while everything else keeps using mocks.
NEXT_PUBLIC_BITCOIN_LIVE=false

# Demo backend (local/CI only, test sats only)
DATABASE_PATH=.data/yebo.json
SESSION_SECRET=change-me-to-32-random-bytes-locally
PIN_PEPPER=change-me-locally
CSRF_SECRET=change-me-locally

# --- Bitcoin rail ---
# Provider selection: altradits (default) | lnd | mock. See docs/BITCOIN.md.
BITCOIN_PROVIDER=altradits

# Altradits Developer API sandbox (Lightning operations). Sandbox keys only.
# Canonical contract: docs/ALTRADITS_CONTRACT.md.
ALTRADITS_API_BASE=http://127.0.0.1:8787/api/dev/v1
ALTRADITS_API_KEY=
ALTRADITS_WEBHOOK_SECRET=
# Set to "fake" to use the in-repo fake instead of a sandbox server.
ALTRADITS_MODE=fake
# YeboBank destination Lightning address for deposits (test network).
YEBO_DESTINATION_ADDRESS=yebo-demo@signet.example

# Self-hosted LND node (BITCOIN_PROVIDER=lnd). See docs/LND.md.
LND_REST_URL=https://127.0.0.1:8080
LND_MACAROON_HEX=
# Dev-only escape hatch for self-signed node certs. NEVER true in production.
LND_ALLOW_INSECURE_TLS=false
LND_TIMEOUT_MS=15000

# Local regtest LND for the fake/sandbox internals only (never mainnet).
# Never point these at a mainnet node (~/.lnd-altradits).
# LND_REGTEST_REST_URL=
# LND_REGTEST_INVOICE_MACAROON=
# LND_REGTEST_READONLY_MACAROON=
# LND_REGTEST_TLS_CERT=

# --- App identity (LNURL callbacks, webhooks) ---
APP_BASE_URL=http://localhost:3000
LIGHTNING_DOMAIN=yebobank.com
# Shared token for the bank's own invoice-poller → webhook callbacks.
WEBHOOK_INTERNAL_TOKEN=
