# YeboBank — bitcoin rail configuration. Copy to .env.local and fill in.
# NEVER commit real keys. See docs/BITCOIN.md, docs/LND.md, docs/ALTRADITS.md.

# --- Provider selection: altradits (default) | lnd | mock ---
BITCOIN_PROVIDER=altradits

# --- Frontend switches (NEXT_PUBLIC_ = visible in the browser) ---
# true → Lightning functions call the real /api routes; rest of the app stays mocked.
NEXT_PUBLIC_BITCOIN_LIVE=false
# Keep true until the full backend exists (only bitcoin /api routes are live today).
NEXT_PUBLIC_USE_MOCKS=true

# --- Altradits hosted rail (default live backend) ---
ALTRADITS_API_URL=https://api.altradits.com
ALTRADITS_API_KEY=
ALTRADITS_WEBHOOK_SECRET=
ALTRADITS_FEE_PCT=1
ALTRADITS_TIMEOUT_MS=15000

# --- Self-hosted LND node (BITCOIN_PROVIDER=lnd) ---
LND_REST_URL=https://127.0.0.1:8080
LND_MACAROON_HEX=
# Dev-only escape hatch for self-signed node certs. NEVER true in production.
LND_ALLOW_INSECURE_TLS=false
LND_TIMEOUT_MS=15000

# --- App identity (LNURL callbacks, webhooks) ---
APP_BASE_URL=http://localhost:3000
LIGHTNING_DOMAIN=yebobank.com
# Shared token for the bank's own invoice-poller → webhook callbacks.
WEBHOOK_INTERNAL_TOKEN=
